{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "SeaOtter",
  "description": "SeaOtter control plane API for managed Hermes Agent hosting",
  "colors": {
    "primary": "#0089FF",
    "light": "#00C8C8",
    "dark": "#0007CD"
  },
  "favicon": "https://seaotter.dev/brand/sea-otter-logo-chip.png",
  "logo": {
    "light": "https://seaotter.dev/brand/sea-otter-logo-chip.png",
    "dark": "https://seaotter.dev/brand/sea-otter-logo-mark.png",
    "href": "https://seaotter.dev"
  },
  "fonts": {
    "family": "DM Sans"
  },
  "background": {
    "color": {
      "light": "#F4F4F5",
      "dark": "#0F0F0F"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "App",
        "href": "https://seaotter.dev"
      },
      {
        "label": "Trust",
        "href": "https://seaotter.dev/trust"
      },
      {
        "label": "Status",
        "href": "https://seaotter.dev/status"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://seaotter.dev/dashboard"
    }
  },
  "footer": {
    "socials": {
      "website": "https://seaotter.dev"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "mdx": {
      "auth": {
        "method": "bearer"
      }
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "authentication",
              "mcp/index"
            ]
          },
          {
            "group": "Connect from chat",
            "pages": [
              "mcp/index",
              "mcp/claude",
              "mcp/cursor",
              "mcp/codex",
              "mcp/tools",
              "mcp/security"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "guides/provisioning-lifecycle",
              "guides/secrets",
              "guides/regions",
              "guides/errors",
              "guides/versioning",
              "guides/changelog"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API reference",
            "pages": [
              "api-reference/overview",
              "api-reference/list-agents",
              "api-reference/create-agent",
              "api-reference/get-agent",
              "api-reference/create-api-key"
            ]
          }
        ],
        "openapi": "openapi.json"
      }
    ],
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "authentication"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "guides/provisioning-lifecycle",
          "guides/regions",
          "guides/errors",
          "guides/versioning",
          "guides/changelog"
        ]
      },
      {
        "group": "API reference",
        "pages": [
          "api-reference/overview",
          "api-reference/list-agents",
          "api-reference/create-agent",
          "api-reference/get-agent",
          "api-reference/create-api-key"
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "download-spec"
    ]
  },
  "metadata": {
    "forceDeploy": "2026-07-31"
  },
  "seo": {
    "indexing": "all"
  }
}
