{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "SeaOtter",
  "description": "Managed control plane for Hermes Agent — always-on hosted agents on Google Cloud, without a VPS or SSH. Docs for seaotter.dev (not seaotter.ai).",
  "colors": {
    "primary": "#0089FF",
    "light": "#00C8C8",
    "dark": "#0007CD"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://seaotter.dev"
  },
  "fonts": {
    "family": "DM Sans"
  },
  "background": {
    "color": {
      "light": "#F4F4F5",
      "dark": "#0F0F0F"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "App",
        "href": "https://seaotter.dev"
      },
      {
        "label": "Trust",
        "href": "https://seaotter.dev/trust"
      },
      {
        "label": "Status",
        "href": "https://seaotter.dev/status"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://seaotter.dev/dashboard"
    }
  },
  "footer": {
    "socials": {
      "website": "https://seaotter.dev"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "mdx": {
      "auth": {
        "method": "bearer"
      }
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "guides/what-is-seaotter",
              "index",
              "guides/self-host-vs-managed",
              "authentication",
              "mcp/index"
            ]
          },
          {
            "group": "Connect from chat",
            "pages": [
              "mcp/index",
              "mcp/claude",
              "mcp/cursor",
              "mcp/codex",
              "mcp/tools",
              "mcp/security"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "guides/provisioning-lifecycle",
              "guides/secrets",
              "guides/regions",
              "guides/errors",
              "guides/versioning",
              "guides/changelog"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API reference",
            "pages": [
              "api-reference/overview",
              "api-reference/list-agents",
              "api-reference/create-agent",
              "api-reference/get-agent",
              "api-reference/create-api-key"
            ]
          }
        ],
        "openapi": "openapi.json"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "download-spec"
    ]
  },
  "metadata": {
    "forceDeploy": "2026-08-18-preview"
  },
  "seo": {
    "indexing": "all",
    "organization": {
      "id": "https://seaotter.dev/#organization",
      "name": "SeaOtter",
      "url": "https://seaotter.dev",
      "logo": "https://seaotter.dev/brand/og-image.png",
      "sameAs": [
        "https://docs.seaotter.dev/",
        "https://hermes-agent.nousresearch.com/docs"
      ]
    }
  }
}
